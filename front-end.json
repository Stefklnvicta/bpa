{
  "rules": [
    {
      "id": "FRONTEND_VISUAL_SPACING_10PX",
      "name": "[Front-end voor 0.8] Minimaal 10 px tussenruimte tussen visuals",
      "description": "Controleert ongegroepeerde, zichtbare data-visuals op onderlinge overlap met 5 px marge rondom ieder object. Daardoor wordt effectief circa 10 px tussenruimte afgedwongen. Decoratieve shapes, textboxes en action buttons worden uitgesloten om false positives te beperken.",
      "logType": "warning",
      "itemType": "Report",
      "part": "Pages",
      "disabled": false,
      "test": [
        {
          "rectoverlap": [
            {
              "map": [
                {
                  "filter": [
                    {
                      "part": "Visuals"
                    },
                    {
                      "and": [
                        {
                          "!!": [
                            {
                              "var": "name"
                            }
                          ]
                        },
                        {
                          "!": [
                            {
                              "var": "isHidden"
                            }
                          ]
                        },
                        {
                          "!": [
                            {
                              "var": "parentGroupName"
                            }
                          ]
                        },
                        {
                          "!": [
                            {
                              "in": [
                                {
                                  "var": "visual.visualType"
                                },
                                [
                                  "shape",
                                  "textbox",
                                  "actionButton"
                                ]
                              ]
                            }
                          ]
                        },
                        {
                          ">=": [
                            {
                              "var": "position.x"
                            },
                            0
                          ]
                        },
                        {
                          ">=": [
                            {
                              "var": "position.y"
                            },
                            0
                          ]
                        },
                        {
                          ">=": [
                            {
                              "var": "position.width"
                            },
                            0
                          ]
                        },
                        {
                          ">=": [
                            {
                              "var": "position.height"
                            },
                            0
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "torecord": [
                    "name",
                    {
                      "var": "name"
                    },
                    "x",
                    {
                      "var": "position.x"
                    },
                    "y",
                    {
                      "var": "position.y"
                    },
                    "width",
                    {
                      "var": "position.width"
                    },
                    "height",
                    {
                      "var": "position.height"
                    }
                  ]
                }
              ]
            },
            5
          ]
        },
        {},
        []
      ]
    },
    {
      "id": "FRONTEND_VISUAL_START_POSITION",
      "name": "[Front-end voor 0.8] Visuals starten vanaf x=18 en y=63",
      "description": "Controleert zichtbare, ongegroepeerde data-visuals op de afgesproken contentmarge: minimaal 18 px vanaf links en 63 px vanaf boven. Shapes, textboxes en action buttons worden uitgesloten.",
      "logType": "warning",
      "itemType": "Report",
      "part": "Pages",
      "disabled": false,
      "test": [
        {
          "map": [
            {
              "filter": [
                {
                  "part": "Visuals"
                },
                {
                  "and": [
                    {
                      "!!": [
                        {
                          "var": "name"
                        }
                      ]
                    },
                    {
                      "!": [
                        {
                          "var": "isHidden"
                        }
                      ]
                    },
                    {
                      "!": [
                        {
                          "var": "parentGroupName"
                        }
                      ]
                    },
                    {
                      "!": [
                        {
                          "in": [
                            {
                              "var": "visual.visualType"
                            },
                            [
                              "shape",
                              "textbox",
                              "actionButton"
                            ]
                          ]
                        }
                      ]
                    },
                    {
                      "or": [
                        {
                          "<": [
                            {
                              "var": "position.x"
                            },
                            18
                          ]
                        },
                        {
                          "<": [
                            {
                              "var": "position.y"
                            },
                            63
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "torecord": [
                "name",
                {
                  "var": "name"
                },
                "x",
                {
                  "var": "position.x"
                },
                "y",
                {
                  "var": "position.y"
                }
              ]
            }
          ]
        },
        {},
        []
      ]
    },
    {
      "id": "FRONTEND_MAX_10_VISUALS_PER_PAGE",
      "name": "[Front-end voor 0.8] Beperk aantal visuals per pagina tot 10",
      "description": "Maximaal 10 zichtbare data-visuals per pagina. Shapes, slicers, action buttons en textboxes tellen niet mee.",
      "logType": "warning",
      "itemType": "Report",
      "part": "Pages",
      "disabled": false,
      "test": [
        {
          "<=": [
            {
              "count": [
                {
                  "filter": [
                    {
                      "part": "Visuals"
                    },
                    {
                      "and": [
                        {
                          "!": [
                            {
                              "var": "isHidden"
                            }
                          ]
                        },
                        {
                          "!": [
                            {
                              "in": [
                                {
                                  "var": "visual.visualType"
                                },
                                [
                                  "shape",
                                  "slicer",
                                  "actionButton",
                                  "textbox"
                                ]
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            10
          ]
        },
        {},
        true
      ]
    },
    {
      "id": "FRONTEND_REFRESH_DATE_PRESENT",
      "name": "[Front-end 0.1] Weergave verversdatum aanwezig",
      "description": "Heuristische rapportbrede controle. Zoekt in alle visuals naar verwijzingen of tekst met refresh/ververs/bijgewerkt/last run/PBI_LastRun. Deze regel is bewust een warning omdat naamgeving per model kan verschillen.",
      "logType": "warning",
      "itemType": "Report",
      "disabled": false,
      "test": [
        {
          ">": [
            {
              "count": [
                {
                  "filter": [
                    {
                      "part": "AllVisuals"
                    },
                    {
                      "strcontains": [
                        {
                          "tostring": [
                            {
                              "var": ""
                            }
                          ]
                        },
                        "(?i)(refresh|ververs|bijgewerkt|last[ _-]?run|pbi[ _-]?last[ _-]?run)"
                      ]
                    }
                  ]
                }
              ]
            },
            0
          ]
        },
        {},
        true
      ]
    },
    {
      "id": "FRONTEND_AXIS_TITLES_PRESENT",
      "name": "[Front-end voor 0.8] As-titels aanwezig",
      "description": "Controleert relevante lijn-, staaf- en kolomgrafieken op ingeschakelde categorie- en waarde-as-titels. Alleen expliciet uitgeschakelde as-titels worden gerapporteerd.",
      "logType": "warning",
      "itemType": "Report",
      "part": "Pages",
      "disabled": false,
      "test": [
        {
          "map": [
            {
              "filter": [
                {
                  "part": "Visuals"
                },
                {
                  "and": [
                    {
                      "in": [
                        {
                          "var": "visual.visualType"
                        },
                        [
                          "lineChart",
                          "barChart",
                          "columnChart",
                          "clusteredBarChart",
                          "stackedBarChart"
                        ]
                      ]
                    },
                    {
                      "or": [
                        {
                          "==": [
                            {
                              "var": "visual.objects.categoryAxis.0.properties.showAxisTitle.expr.Literal.Value"
                            },
                            "false"
                          ]
                        },
                        {
                          "==": [
                            {
                              "var": "visual.objects.valueAxis.0.properties.showAxisTitle.expr.Literal.Value"
                            },
                            "false"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "var": "name"
            }
          ]
        },
        {},
        []
      ]
    },
    {
      "id": "FRONTEND_NAV_BUTTONS_HAVE_TARGET",
      "name": "[Front-end voor 0.8] Navigatieknoppen hebben een bestemming",
      "description": "Controleert zichtbare action buttons op een geldige visual link, zoals bookmark-, pagina-, web- of drillthroughnavigatie.",
      "logType": "warning",
      "itemType": "Report",
      "part": "Pages",
      "disabled": false,
      "test": [
        {
          "map": [
            {
              "filter": [
                {
                  "part": "Visuals"
                },
                {
                  "and": [
                    {
                      "==": [
                        {
                          "var": "visual.visualType"
                        },
                        "actionButton"
                      ]
                    },
                    {
                      "!": [
                        {
                          "var": "isHidden"
                        }
                      ]
                    },
                    {
                      "none": [
                        {
                          "var": "visual.visualContainerObjects.visualLink"
                        },
                        {
                          "or": [
                            {
                              "!!": [
                                {
                                  "var": "properties.bookmark"
                                }
                              ]
                            },
                            {
                              "!!": [
                                {
                                  "var": "properties.navigationSection"
                                }
                              ]
                            },
                            {
                              "!!": [
                                {
                                  "var": "properties.webUrl"
                                }
                              ]
                            },
                            {
                              "!!": [
                                {
                                  "var": "properties.drillthroughSection"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "var": "name"
            }
          ]
        },
        {},
        []
      ]
    },
    {
      "id": "FRONTEND_HIDE_TOOLTIP_DRILLTHROUGH_PAGES",
      "name": "[Front-end voor 0.8] Tooltip- en drill-throughpagina's zijn verborgen",
      "description": "Tooltip- en drillthroughpagina's mogen niet zichtbaar zijn in de normale paginanavigatie voor eindgebruikers.",
      "logType": "warning",
      "itemType": "Report",
      "disabled": false,
      "test": [
        {
          "map": [
            {
              "filter": [
                {
                  "part": "Pages"
                },
                {
                  "and": [
                    {
                      "in": [
                        {
                          "var": "pageBinding.type"
                        },
                        [
                          "Tooltip",
                          "Drillthrough"
                        ]
                      ]
                    },
                    {
                      "!=": [
                        {
                          "var": "visibility"
                        },
                        "HiddenInViewMode"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "var": "displayName"
            }
          ]
        },
        {},
        []
      ]
    },
    {
      "id": "FRONTEND_DRILLTHROUGH_TITLE",
      "name": "[Front-end voor 0.8] Drill-throughpagina heeft duidelijke titel",
      "description": "Controleert of de naam van een drillthroughpagina 'Drill-Through' of 'Drillthrough' bevat. Hiermee blijft de functie van detailpagina's herkenbaar voor ontwikkelaars.",
      "logType": "warning",
      "itemType": "Report",
      "part": "Pages",
      "disabled": false,
      "test": [
        {
          "?:": [
            {
              "==": [
                {
                  "var": "pageBinding.type"
                },
                "Drillthrough"
              ]
            },
            {
              "strcontains": [
                {
                  "var": "displayName"
                },
                "(?i)drill[- ]?through"
              ]
            },
            true
          ]
        },
        {},
        true
      ]
    },
    {
      "id": "FRONTEND_MAX_4_SLICERS_PER_PAGE",
      "name": "[Front-end voor 0.8] Beperk aantal slicers",
      "description": "Maximaal 4 zichtbare slicers per pagina. Dit is een conservatieve, eenduidige CI-interpretatie van de richtlijn 'maximaal 4 slicers per rij'; rijherkenning op basis van y-coordinaten zou onnodig foutgevoelig zijn.",
      "logType": "warning",
      "itemType": "Report",
      "part": "Pages",
      "disabled": false,
      "test": [
        {
          "<=": [
            {
              "count": [
                {
                  "filter": [
                    {
                      "part": "Visuals"
                    },
                    {
                      "and": [
                        {
                          "==": [
                            {
                              "var": "visual.visualType"
                            },
                            "slicer"
                          ]
                        },
                        {
                          "!": [
                            {
                              "var": "isHidden"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            4
          ]
        },
        {},
        true
      ]
    }
  ]
}
